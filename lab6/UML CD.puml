@startuml CD

package "Car Inventory System" {
    [Client App]
    [Car Inventory] << Service >>
    [VIN Decoder] << Service >>
    () "car-info" as decode1

    [Client App] -( cars
    cars - [Car Inventory]
    [Car Inventory] -( decode1
    decode1 - [VIN Decoder]

    database Cars << repository >>
    [Car Inventory] -down- Cars

    database "Domestic VINs" << repository >>
    [VIN Decoder] -down- [Domestic VINs]
}

() "car-info" as decode2
[Foreign VIN Decoder] << Service >>
[VIN Decoder] -down--( decode2
decode2 -left- [Foreign VIN Decoder]

@enduml